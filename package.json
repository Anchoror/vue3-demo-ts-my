{
  "name": "vue3-demo",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.1.2",
  "description": "",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode=test",
    "dev:prod": "vite --mode=production",
    "build": "vue-tsc --noEmit && vite build",
    "build:dev": "vue-tsc --noEmit && vite build --mode=development",
    "build:test": "vue-tsc --noEmit && vite build --mode=test",
    "build:both": "concurrently \"pnpm run build:test\" \"pnpm run build\"",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@unhead/vue": "^1.11.14",
    "@unocss/reset": "^0.61.9",
    "@vueuse/core": "^10.11.1",
    "axios": "^1.7.9",
    "element-plus": "^2.9.0",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.0",
    "pinia-plugin-persistedstate": "^3.2.3",
    "unplugin-preprocessor-directives": "^1.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.27.3",
    "@iconify-json/ep": "^1.2.1",
    "@types/node": "^20.17.10",
    "@unocss/eslint-plugin": "0.60.4",
    "@unocss/preset-rem-to-px": "^0.61.9",
    "@vitejs/plugin-legacy": "^5.4.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
